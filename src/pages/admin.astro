---
import { Buffer } from "node:buffer";
import fs from "node:fs/promises";
import path from "node:path";
import exifReader from "exif-reader";
import AdminDashboard from "../components/AdminDashboard";
import Layout from "../layouts/BaseLayout.astro";
import {
  addImage,
  createAlbum,
  deleteItem,
  deleteItems,
  getImages,
  type ImageRecord,
  saveImages,
} from "../lib/imageStore";
import {
  getSettings,
  saveSettings,
  updatePassword,
} from "../lib/settingsStore";

// Handle POST actions
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");

    if (action === "updateGallery") {
      const minHeight = Number(formData.get("minHeight"));
      const gap = Number(formData.get("gap"));
      const wideAspectRatioThreshold = Number(
        formData.get("wideAspectRatioThreshold"),
      );
      const tallAspectRatioThreshold = Number(
        formData.get("tallAspectRatioThreshold"),
      );
      const largeImageMinHeight = Number(formData.get("largeImageMinHeight"));

      const settings = await getSettings();
      settings.gallery = {
        minHeight,
        gap,
        wideAspectRatioThreshold,
        tallAspectRatioThreshold,
        largeImageMinHeight,
      };
      await saveSettings(settings);
    } else if (action === "updatePassword") {
      const password = formData.get("password") as string;
      if (password) {
        await updatePassword(password);
      }
    } else if (action === "createAlbum") {
      const title = formData.get("title") as string;
      const description = formData.get("description") as string;
      if (title) {
        await createAlbum(title, description || "");
      }
    } else if (action === "upload") {
      const files = formData.getAll("file") as File[];
      const albumId = formData.get("albumId") as string;

      for (const file of files) {
        if (file && file.size > 0) {
          const buffer = Buffer.from(await file.arrayBuffer());
          const filename = `${Date.now()}-${Math.random().toString(36).substring(7)}-${file.name.replace(/[^a-zA-Z0-9.-]/g, "")}`;
          const uploadPath = path.join(
            process.cwd(),
            "public",
            "uploads",
            filename,
          );

          // Ensure directory exists
          await fs.mkdir(path.dirname(uploadPath), { recursive: true });
          await fs.writeFile(uploadPath, buffer);

          let width = 800;
          let height = 600;
          let exifData: ImageRecord["exif"];

          try {
            const { default: sharp } = await import("sharp");
            const image = sharp(buffer);
            const metadata = await image.metadata();
            width = metadata.width || 800;
            height = metadata.height || 600;

            if (metadata.exif) {
              try {
                const parsed = exifReader(metadata.exif) as any;

                const formatShutter = (val?: number) => {
                  if (!val) return undefined;
                  if (val >= 1) return `${val}s`;
                  return `1/${Math.round(1 / val)}`;
                };

                exifData = {
                  iso: parsed.exif?.ISO,
                  fStop: parsed.exif?.FNumber,
                  shutterSpeed: formatShutter(parsed.exif?.ExposureTime),
                  model: parsed.image?.Model,
                  make: parsed.image?.Make,
                  focalLength: parsed.exif?.FocalLength,
                  lensModel: parsed.exif?.LensModel,
                  date: parsed.exif?.DateTimeOriginal
                    ? new Date(parsed.exif.DateTimeOriginal).toISOString()
                    : undefined,
                };
              } catch (e) {
                console.warn("Failed to parse EXIF", e);
              }
            }
          } catch (e) {
            console.error("Failed to get dimensions/exif", e);
          }

          const newImage: ImageRecord = {
            id: filename,
            type: "upload",
            src: `/uploads/${filename}`,
            width,
            height,
            exif: exifData,
          };
          await addImage(newImage, albumId || undefined);
        }
      }
    } else if (action === "delete") {
      const id = formData.get("id") as string;
      await deleteItem(id);
    } else if (action === "batchDelete") {
      const idsString = formData.get("ids") as string;
      if (idsString) {
        try {
          const ids = JSON.parse(idsString);
          if (Array.isArray(ids)) {
            await deleteItems(ids);
          }
        } catch (e) {
          console.error("Failed to parse ids for batch delete", e);
        }
      }
    } else if (action === "moveUp") {
      const id = formData.get("id") as string;
      const images = await getImages();
      const index = images.findIndex((img) => img.id === id);
      if (index > 0) {
        const temp = images[index];
        images[index] = images[index - 1];
        images[index - 1] = temp;
        await saveImages(images);
      }
    } else if (action === "moveDown") {
      const id = formData.get("id") as string;
      const images = await getImages();
      const index = images.findIndex((img) => img.id === id);
      if (index < images.length - 1) {
        const temp = images[index];
        images[index] = images[index + 1];
        images[index + 1] = temp;
        await saveImages(images);
      }
    }
  } catch (error) {
    console.error(error);
  }
  return Astro.redirect("/admin");
}

const images = await getImages();
const settings = await getSettings();
---

<Layout title="Admin Panel" description="Manage your photo grid" htmlClass="dark">
  <AdminDashboard images={images} settings={settings} client:load />
</Layout>