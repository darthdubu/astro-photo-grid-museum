---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { Buffer } from "node:buffer";
import fs from "node:fs/promises";
import path from "node:path";
import { Folder } from "lucide-react";
import AlbumModal from "../components/AlbumModal.astro";
import {
  type Album,
  getImages,
  type ImageRecord,
  saveImages,
} from "../lib/imageStore";

const localImagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../images/*.{jpg,jpeg,png,webp}",
);

let storedImages = await getImages();

if (storedImages.length === 0) {
  // 1. Load local images from src/images (if any)
  const localKeys = Object.keys(localImagesGlob);
  const initialImages: ImageRecord[] = localKeys.map((key) => {
    const filename = key.split("/").pop();
    return {
      id: filename || key,
      type: "local",
      src: key,
    };
  });

  // 2. Scan public/uploads for existing files
  try {
    const uploadsDir = path.join(process.cwd(), "public", "uploads");
    const files = await fs.readdir(uploadsDir);

    // We need 'sharp' to get dimensions for existing uploads
    const { default: sharp } = await import("sharp");

    for (const file of files) {
      if (file.match(/\.(jpg|jpeg|png|webp)$/i)) {
        const filePath = path.join(uploadsDir, file);
        try {
          const buffer = await fs.readFile(filePath);
          const metadata = await sharp(buffer).metadata();

          initialImages.push({
            id: file,
            type: "upload",
            src: `/uploads/${file}`,
            width: metadata.width || 800,
            height: metadata.height || 600,
          });
        } catch (err) {
          console.error(`Failed to process upload ${file}:`, err);
        }
      }
    }
  } catch (e) {
    // Directory might not exist or other error, ignore
    console.log("No uploads found or error scanning uploads:", e);
  }

  storedImages = initialImages;
  await saveImages(storedImages);
}

interface RenderImage extends ImageRecord {
  asset?: ImageMetadata;
  width: number;
  height: number;
}

interface RenderAlbum extends Album {
  width: number;
  height: number;
  coverAsset?: ImageMetadata;
}

type RenderItem = RenderImage | RenderAlbum;

const itemsToRender: (RenderItem | null)[] = await Promise.all(
  storedImages.map(async (item) => {
    if (item.type === "album") {
      const cover = item.coverImage || item.images[0];
      if (!cover) return null; // Empty album without cover

      let width = cover.width || 800;
      let height = cover.height || 600;
      let coverAsset: ImageMetadata | undefined;

      if (cover.type === "local") {
        const loader = localImagesGlob[cover.src];
        if (loader) {
          const { default: imageData } = await loader();
          width = imageData.width;
          height = imageData.height;
          coverAsset = imageData;
        }
      }

      return {
        ...item,
        width,
        height,
        coverAsset,
      } as RenderAlbum;
    }

    const img = item as ImageRecord;
    if (img.type === "local") {
      const loader = localImagesGlob[img.src];
      if (loader) {
        const { default: imageData } = await loader();
        return {
          ...img,
          width: imageData.width,
          height: imageData.height,
          asset: imageData,
        };
      }
      return null;
    } else {
      // For uploads, we assume width/height are present.
      // If not, we might filter them out or provide defaults.
      if (img.width && img.height) {
        return img as RenderImage;
      }
      return null;
    }
  }),
);

const validItems = itemsToRender.filter(
  (item): item is RenderItem => item !== null,
);
---

<BaseLayout
  title="June Flowers"
  description="A minimal, single-page photo gallery for Astro."
  htmlClass="dark horizontal-gallery"
>
  <div class="noise-overlay"></div>
  <div class="lighting-layer"></div>
  
  <main class="multi-column-container">
    <header class="zen-header-multi">
      <div class="zen-logo">
        <div class="hanko"></div>
      </div>
      <div class="zen-decoration-line"></div>
    </header>

    <section id="masonry-root" class="min-h-screen">
      <!-- Images will be distributed here by JS -->
    </section>

    <!-- Hidden Source for Masonry JS -->
    <div id="gallery-source" style="display: none;">
      {
        validItems.map((item, index) => {
          const isAlbum = item.type === 'album';
          const renderItem = item as RenderItem;
          const width = renderItem.width;
          const height = renderItem.height;
          const aspectRatio = width / height;
          
          return (
            <div 
              class="gallery-item-multi"
              data-aspect-ratio={aspectRatio}
            >
              {isAlbum ? (
                <a
                  href="#"
                  data-album-id={renderItem.id}
                  class="group relative block w-full h-full overflow-hidden album-trigger"
                >
                  {(renderItem as RenderAlbum).coverAsset ? (
                    <Image
                      format="webp"
                      src={(renderItem as RenderAlbum).coverAsset!}
                      alt={(renderItem as RenderAlbum).title}
                      width={width}
                      height={height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  ) : (
                    <img
                      src={(renderItem as RenderAlbum).coverAsset ? (renderItem as RenderAlbum).coverAsset!.src : ((renderItem as RenderAlbum).coverImage ? (renderItem as RenderAlbum).coverImage!.src : '')}
                      alt={(renderItem as RenderAlbum).title}
                      width={width}
                      height={height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  )}
                  
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-500"></div>
                  
                  <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-4 group-hover:translate-y-0">
                    <div class="w-12 h-12 mb-4 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20">
                      <Folder className="w-5 h-5 text-white" />
                    </div>
                    <h3 class="text-2xl font-serif text-white tracking-widest uppercase mb-2">{(renderItem as RenderAlbum).title}</h3>
                    <p class="text-white/80 font-mono text-xs tracking-wider">{(renderItem as RenderAlbum).images.length} Photos</p>
                  </div>
                </a>
              ) : (
                <a
                  href={typeof (renderItem as RenderImage).asset === 'object' ? (renderItem as RenderImage).asset!.src : (renderItem as RenderImage).src}
                  data-fancybox="gallery"
                  data-exif={JSON.stringify((renderItem as RenderImage).exif || {})}
                  class="group relative block w-full h-full overflow-hidden"
                >
                  {(renderItem as RenderImage).asset ? (
                    <Image
                      format="webp"
                      src={(renderItem as RenderImage).asset!}
                      alt=""
                      width={renderItem.width}
                      height={renderItem.height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <img
                      src={(renderItem as RenderImage).src}
                      alt=""
                      width={renderItem.width}
                      height={renderItem.height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  )}
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </main>

  <div class="controls-container">
    <a href="https://instagram.com/juniesdream" target="_blank" class="control-btn" aria-label="Instagram">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
    </a>
    <div class="control-divider"></div>
    <button id="btn-view-1" class="control-btn active" aria-label="Horizontal View">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="3" x2="21" y1="15" y2="15"/></svg>
    </button>
    <button id="btn-view-2" class="control-btn" aria-label="Grid View">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
    </button>
    <div class="control-divider"></div>
    <button id="btn-slideshow" class="control-btn" aria-label="Start Slideshow">
      <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <svg id="icon-pause" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
    </button>
  </div>

  <!-- Album Modals -->
  {
    validItems
      .filter((item): item is RenderAlbum => item.type === 'album')
      .map((album) => (
        <AlbumModal 
          album={album} 
          isOpen={false} 
          onClose={() => {}} 
        />
      ))
  }
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui";
  import type { ExifData } from "../lib/imageStore";

  // State
  let currentView = 'horizontal'; // 'horizontal' | 'vertical'
  let isPlaying = false;
  let animationFrameId: number;
  let observer: IntersectionObserver;
  let lastSpacePressTime = 0;
  let speedMultiplier = 1;
  const baseScrollSpeed = 0.5;

  // DOM Elements
  const masonryRoot = document.getElementById('masonry-root');
  const gallerySource = document.getElementById('gallery-source');
  const zenHeader = document.querySelector('.zen-header-multi') as HTMLElement;
  let horizontalContainer: HTMLElement;

  // Initialize
  function init() {
    if (!masonryRoot || !gallerySource) return;

    // Create Horizontal Container
    horizontalContainer = document.createElement('div');
    horizontalContainer.className = 'horizontal-scroll-view';
    document.body.appendChild(horizontalContainer);

    // Bind Controls
    const btnView1 = document.getElementById('btn-view-1');
    const btnView2 = document.getElementById('btn-view-2');
    const btnSlideshow = document.getElementById('btn-slideshow');

    if (btnView1) btnView1.addEventListener('click', () => setView('horizontal'));
    if (btnView2) btnView2.addEventListener('click', () => setView('vertical'));
    if (btnSlideshow) btnSlideshow.addEventListener('click', toggleSlideshow);

    // Bind Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        // Ignore if focus is on input/textarea
        const activeTag = document.activeElement?.tagName.toLowerCase();
        if (activeTag === 'input' || activeTag === 'textarea') return;

        // Ignore if Fancybox is open
        if (Fancybox.getInstance()) return;
        
        // Ignore if Album Modal is open
        const isAlbumOpen = document.querySelector('[id^="album-modal-"].opacity-100');
        if (isAlbumOpen) return;

        e.preventDefault();
        
        const now = Date.now();
        if (now - lastSpacePressTime < 300) {
          // Double press detected
          speedMultiplier = 3;
          if (!isPlaying) {
             startSlideshow();
          } else {
             // If already playing, just update speed (handled in animate loop)
             // But if we want to ensure it's running:
             startSlideshow(); 
          }
        } else {
          // Single press (or first of double)
          speedMultiplier = 1;
          toggleSlideshow();
        }
        lastSpacePressTime = now;
      }
    });

    // Initialize Fancybox
    initFancybox();
    initAlbumModals();

    // Initial View
    setView('horizontal');

    // Handle Resize (only relevant for Masonry responsive fallback if we wanted it, but we force 2 cols for now)
    // We can keep a listener if we decide to be responsive in vertical mode later
  }

  function setView(mode: 'horizontal' | 'vertical') {
    currentView = mode;

    // Update Buttons
    document.getElementById('btn-view-1')?.classList.toggle('active', mode === 'horizontal');
    document.getElementById('btn-view-2')?.classList.toggle('active', mode === 'vertical');

    // Stop Slideshow if switching away from horizontal
    if (mode === 'vertical') {
      stopSlideshow();
    }

    if (mode === 'horizontal') {
      // Show Horizontal
      if (horizontalContainer) horizontalContainer.style.display = 'flex';
      if (masonryRoot) masonryRoot.style.display = 'none';
      if (zenHeader) zenHeader.style.display = 'none'; // Hide header for immersion
      
      document.body.classList.add('mode-horizontal');
      document.body.classList.remove('mode-vertical');

      // Populate if empty
      if (horizontalContainer && horizontalContainer.children.length === 0) {
        renderHorizontal();
      }
    } else {
      // Show Vertical
      if (horizontalContainer) horizontalContainer.style.display = 'none';
      if (masonryRoot) masonryRoot.style.display = 'flex';
      if (zenHeader) zenHeader.style.display = 'flex';

      document.body.classList.add('mode-vertical');
      document.body.classList.remove('mode-horizontal');

      // Render 2-column grid
      renderMasonry(2);
    }
  }

  function renderHorizontal() {
    if (!horizontalContainer || !gallerySource) return;
    horizontalContainer.innerHTML = '';

    const items = Array.from(gallerySource.children) as HTMLElement[];
    items.forEach((itemTemplate) => {
      const item = itemTemplate.cloneNode(true) as HTMLElement;
      horizontalContainer.appendChild(item);
      
      // Init observer for this item
      if (observer) observer.observe(item);
      
      // Remove aspect-ratio style for horizontal view to let img define width
      item.style.aspectRatio = '';
    });
    
    // Re-init observer
    initAnimations(horizontalContainer.querySelectorAll('.gallery-item-multi'));
  }

  function renderMasonry(columns: number) {
    if (!masonryRoot || !gallerySource) return;

    masonryRoot.innerHTML = '';
    masonryRoot.className = 'masonry-grid';

    const columnElements: HTMLElement[] = [];
    const columnHeights = new Array(columns).fill(0);

    for (let i = 0; i < columns; i++) {
      const col = document.createElement('div');
      col.className = 'masonry-column';
      masonryRoot.appendChild(col);
      columnElements.push(col);
    }

    const items = Array.from(gallerySource.children) as HTMLElement[];
    items.forEach((itemTemplate) => {
      const item = itemTemplate.cloneNode(true) as HTMLElement;
      
      const minHeight = Math.min(...columnHeights);
      const columnIndex = columnHeights.indexOf(minHeight);
      
      columnElements[columnIndex].appendChild(item);
      
      const ratio = parseFloat(item.dataset.aspectRatio || '1');
      columnHeights[columnIndex] += (1 / ratio);
    });

    initAnimations(masonryRoot.querySelectorAll('.gallery-item-multi'));
  }

  function toggleSlideshow() {
    if (isPlaying) {
      stopSlideshow();
    } else {
      startSlideshow();
    }
  }

  function startSlideshow() {
    isPlaying = true;
    document.getElementById('btn-slideshow')?.classList.add('active');
    document.getElementById('icon-play')?.classList.add('hidden');
    document.getElementById('icon-pause')?.classList.remove('hidden');

    // Disable smooth scrolling for JS animation to prevent stutter
    if (currentView === 'horizontal') {
      if (horizontalContainer) {
        horizontalContainer.style.scrollBehavior = 'auto';
      }
    } else {
      document.documentElement.style.scrollBehavior = 'auto';
      document.body.style.scrollBehavior = 'auto';
    }

    function animate() {
      if (!isPlaying) return;

      const currentSpeed = baseScrollSpeed * speedMultiplier;

      if (currentView === 'horizontal') {
        if (!horizontalContainer) return;
        horizontalContainer.scrollLeft += currentSpeed;

        if (horizontalContainer.scrollLeft >= horizontalContainer.scrollWidth - horizontalContainer.clientWidth) {
           stopSlideshow();
           return;
        }
      } else {
        // Vertical Scroll
        window.scrollBy(0, currentSpeed);
        
        // Check if bottom reached
        if ((window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 5) {
            stopSlideshow();
            return;
        }
      }

      animationFrameId = requestAnimationFrame(animate);
    }
    
    animate();
  }

  function stopSlideshow() {
    isPlaying = false;
    cancelAnimationFrame(animationFrameId);
    document.getElementById('btn-slideshow')?.classList.remove('active');
    document.getElementById('icon-play')?.classList.remove('hidden');
    document.getElementById('icon-pause')?.classList.add('hidden');
    
    // Restore smooth scrolling
    if (horizontalContainer) {
      horizontalContainer.style.scrollBehavior = 'smooth';
    }
    document.documentElement.style.scrollBehavior = 'smooth';
    document.body.style.scrollBehavior = 'smooth';
  }

  function initAnimations(items: NodeListOf<Element>) {
    const observerOptions = {
      root: currentView === 'horizontal' ? horizontalContainer : null,
      rootMargin: '100px',
      threshold: 0.1
    };

    if (observer) observer.disconnect();

    observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    items.forEach(item => {
      observer.observe(item);
    });
  }

  function initFancybox() {
    Fancybox.bind("[data-fancybox='gallery']", {
      theme: "auto",
      mainStyle: {
        "--f-button-width": "44px",
        "--f-button-height": "44px",
        "--f-button-border-radius": "50%",
        "--f-toolbar-padding": "16px",
      },
      caption: (fancybox: any, slide: any) => {
        const exifData = slide.triggerEl?.dataset.exif;
        let exif: ExifData = {};
        try {
          exif = exifData ? JSON.parse(exifData) : {};
        } catch (e) {
          console.error("Failed to parse EXIF data", e);
        }
        
        const hasExif = exif.model || exif.focalLength || exif.fStop || exif.shutterSpeed || exif.iso;
        
        if (!hasExif) return slide.caption || "";

        return `
          <div class="exif-panel-glass">
            ${exif.model ? `<div class="exif-model">${exif.model}</div>` : ''}
            <div class="exif-grid">
              ${exif.focalLength ? `
                <div class="exif-item">
                  <span class="exif-label">FOCAL</span>
                  <span class="exif-value">${exif.focalLength}mm</span>
                </div>` : ''}
              ${exif.fStop ? `
                <div class="exif-item">
                  <span class="exif-label">APERTURE</span>
                  <span class="exif-value">f/${exif.fStop}</span>
                </div>` : ''}
              ${exif.shutterSpeed ? `
                <div class="exif-item">
                  <span class="exif-label">SHUTTER</span>
                  <span class="exif-value">${exif.shutterSpeed}s</span>
                </div>` : ''}
              ${exif.iso ? `
                <div class="exif-item">
                  <span class="exif-label">ISO</span>
                  <span class="exif-value">${exif.iso}</span>
                </div>` : ''}
            </div>
          </div>
        `;
      },
      Carousel: {
        Arrows: false,
        Toolbar: {
          display: {
            left: [],
            middle: [],
            right: ["close"],
          },
        },
        transition: "slide",
      },
    } as any);
  }

  function initAlbumModals() {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('.album-trigger');
      if (trigger) {
        e.preventDefault();
        const albumId = trigger.getAttribute('data-album-id');
        if (albumId) openAlbumModal(albumId);
      }
    });

    document.addEventListener('close-album-modal', (e: any) => {
      if (e.detail?.albumId) closeAlbumModal(e.detail.albumId);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[id^="album-modal-"]:not(.opacity-0)').forEach(modal => {
          const albumId = modal.getAttribute('data-album-id');
          if (albumId) closeAlbumModal(albumId);
        });
      }
    });
  }

  function openAlbumModal(albumId: string) {
    const modal = document.getElementById(`album-modal-${albumId}`);
    if (modal) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      Fancybox.bind(`[data-fancybox="album-${albumId}"]`, {
          theme: "auto",
          Carousel: { transition: "slide" }
      });
    }
  }

  function closeAlbumModal(albumId: string) {
    const modal = document.getElementById(`album-modal-${albumId}`);
    if (modal) {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  // Run
  document.addEventListener('DOMContentLoaded', init);
</script>

<style>
  :root {
    --museum-bg: #1a1918; /* Warm dark charcoal */
    --museum-text: #e8e6e3; /* Warm off-white */
    --museum-accent: #d4c5b0; /* Muted gold/beige */
  }

  body {
    background-color: var(--museum-bg);
    color: var(--museum-text);
    font-family: 'Shippori Mincho', serif;
    overflow-x: hidden;
  }

  /* Zen Header Styles - Simplified for Museum feel */
  .zen-header-multi {
    padding: 6rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    position: relative;
    z-index: 20;
  }

  .zen-logo {
    position: relative;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hanko {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    position: relative;
    transition: all 0.5s ease;
  }

  .hanko::after {
    content: " ";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 0 20px 5px rgba(255, 255, 255, 0.2);
  }

  .zen-decoration-line {
    width: 1px;
    height: 100px;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.3), rgba(255,255,255,0));
  }

  /* Puzzle Grid Layout */
  /* Lighting Effects */
  .lighting-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    background: 
      radial-gradient(circle at 15% 20%, rgba(255, 200, 150, 0.08), transparent 50%),
      radial-gradient(circle at 85% 80%, rgba(255, 200, 150, 0.06), transparent 50%);
    mix-blend-mode: screen;
  }

  .multi-column-container {
    max-width: 100%;
    margin: 0;
    padding: 16px 16px 8rem; /* Added padding for frame effect */
  }

  /* Controls */
  .controls-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 60; /* Above noise and other overlays */
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
