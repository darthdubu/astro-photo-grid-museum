---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { Buffer } from "node:buffer";
import fs from "node:fs/promises";
import path from "node:path";
import { Folder } from "lucide-react";
import AlbumModal from "../components/AlbumModal.astro";
import {
  type Album,
  getImages,
  type ImageRecord,
  saveImages,
} from "../lib/imageStore";

const localImagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../images/*.{jpg,jpeg,png,webp}",
);

let storedImages = await getImages();

if (storedImages.length === 0) {
  // 1. Load local images from src/images (if any)
  const localKeys = Object.keys(localImagesGlob);
  const initialImages: ImageRecord[] = localKeys.map((key) => {
    const filename = key.split("/").pop();
    return {
      id: filename || key,
      type: "local",
      src: key,
    };
  });

  // 2. Scan public/uploads for existing files
  try {
    const uploadsDir = path.join(process.cwd(), "public", "uploads");
    const files = await fs.readdir(uploadsDir);

    // We need 'sharp' to get dimensions for existing uploads
    const { default: sharp } = await import("sharp");

    for (const file of files) {
      if (file.match(/\.(jpg|jpeg|png|webp)$/i)) {
        const filePath = path.join(uploadsDir, file);
        try {
          const buffer = await fs.readFile(filePath);
          const metadata = await sharp(buffer).metadata();

          initialImages.push({
            id: file,
            type: "upload",
            src: `/uploads/${file}`,
            width: metadata.width || 800,
            height: metadata.height || 600,
          });
        } catch (err) {
          console.error(`Failed to process upload ${file}:`, err);
        }
      }
    }
  } catch (e) {
    // Directory might not exist or other error, ignore
    console.log("No uploads found or error scanning uploads:", e);
  }

  storedImages = initialImages;
  await saveImages(storedImages);
}

interface RenderImage extends ImageRecord {
  asset?: ImageMetadata;
  width: number;
  height: number;
}

interface RenderAlbum extends Album {
  width: number;
  height: number;
  coverAsset?: ImageMetadata;
}

type RenderItem = RenderImage | RenderAlbum;

const itemsToRender: (RenderItem | null)[] = await Promise.all(
  storedImages.map(async (item) => {
    if (item.type === "album") {
      const cover = item.coverImage || item.images[0];
      if (!cover) return null; // Empty album without cover

      let width = cover.width || 800;
      let height = cover.height || 600;
      let coverAsset: ImageMetadata | undefined;

      if (cover.type === "local") {
        const loader = localImagesGlob[cover.src];
        if (loader) {
          const { default: imageData } = await loader();
          width = imageData.width;
          height = imageData.height;
          coverAsset = imageData;
        }
      }

      return {
        ...item,
        width,
        height,
        coverAsset,
      } as RenderAlbum;
    }

    const img = item as ImageRecord;
    if (img.type === "local") {
      const loader = localImagesGlob[img.src];
      if (loader) {
        const { default: imageData } = await loader();
        return {
          ...img,
          width: imageData.width,
          height: imageData.height,
          asset: imageData,
        };
      }
      return null;
    } else {
      // For uploads, we assume width/height are present.
      // If not, we might filter them out or provide defaults.
      if (img.width && img.height) {
        return img as RenderImage;
      }
      return null;
    }
  }),
);

const validItems = itemsToRender.filter(
  (item): item is RenderItem => item !== null,
);
---

<BaseLayout
  title="Astro Photo Grid"
  description="A minimal, single-page photo gallery for Astro."
  htmlClass="dark horizontal-gallery"
>
  <div class="noise-overlay"></div>
  
  <main class="multi-column-container">
    <header class="zen-header-multi">
      <div class="zen-logo">
        <div class="hanko"></div>
      </div>
      <div class="zen-decoration-line"></div>
    </header>

    <section 
      class="multi-column-gallery" 
      id="photoswipe"
    >
      {
        validItems.map((item, index) => {
          const isAlbum = item.type === 'album';
          const renderItem = item as RenderItem;
          const width = renderItem.width;
          const height = renderItem.height;
          
          // Calculate responsive sizing for puzzle grid layout
          const aspectRatio = width / height;
          let gridColumn = "span 1";
          let gridRow = "span 1";

          // Puzzle logic based on aspect ratio
          if (aspectRatio > 1.6) {
            // Wide Panorama -> Span 2 cols, 1 row
            gridColumn = "span 2";
          } else if (aspectRatio < 0.6) {
            // Tall Portrait -> Span 1 col, 2 rows
            gridRow = "span 2";
          } else if (aspectRatio > 1.2) {
             // Landscape -> Span 2 cols, 2 rows (Big square-ish) for emphasis? 
             // Or keep simple. Let's make "standard" landscape span 2 cols to vary rhythm
             gridColumn = "span 2";
          } else if (width > 1200) {
             // High Res -> Big Block
             gridColumn = "span 2";
             gridRow = "span 2";
          }

          return (
            <div 
              class="gallery-item-multi" 
              style={{ 
                gridColumn,
                gridRow,
                aspectRatio: `${aspectRatio}` 
              }}
            >
              {isAlbum ? (
                <a
                  href="#"
                  data-album-id={renderItem.id}
                  class="group relative block w-full h-full overflow-hidden album-trigger"
                >
                  {(renderItem as RenderAlbum).coverAsset ? (
                    <Image
                      format="webp"
                      src={(renderItem as RenderAlbum).coverAsset!}
                      alt={(renderItem as RenderAlbum).title}
                      width={width}
                      height={height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  ) : (
                    <img
                      src={(renderItem as RenderAlbum).coverAsset ? (renderItem as RenderAlbum).coverAsset!.src : ((renderItem as RenderAlbum).coverImage ? (renderItem as RenderAlbum).coverImage!.src : '')}
                      alt={(renderItem as RenderAlbum).title}
                      width={width}
                      height={height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  )}
                  
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-500"></div>
                  
                  <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-4 group-hover:translate-y-0">
                    <div class="w-12 h-12 mb-4 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20">
                      <Folder class="w-5 h-5 text-white" />
                    </div>
                    <h3 class="text-2xl font-serif text-white tracking-widest uppercase mb-2">{(renderItem as RenderAlbum).title}</h3>
                    <p class="text-white/80 font-mono text-xs tracking-wider">{(renderItem as RenderAlbum).images.length} Photos</p>
                  </div>
                </a>
              ) : (
                <a
                  href={typeof (renderItem as RenderImage).asset === 'object' ? (renderItem as RenderImage).asset!.src : (renderItem as RenderImage).src}
                  data-fancybox="gallery"
                  class="group relative block w-full h-full overflow-hidden"
                >
                  {(renderItem as RenderImage).asset ? (
                    <Image
                      format="webp"
                      src={(renderItem as RenderImage).asset!}
                      alt=""
                      width={renderItem.width}
                      height={renderItem.height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <img
                      src={(renderItem as RenderImage).src}
                      alt=""
                      width={renderItem.width}
                      height={renderItem.height}
                      loading={index < 5 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  )}
                  
                  {(renderItem as RenderImage).exif && (
                    <div class="absolute inset-x-0 bottom-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
                       {(renderItem as RenderImage).exif?.model && <p class="text-xs tracking-[0.3em] uppercase text-white/90 font-serif mb-2 border-b border-white/20 pb-2 inline-block">{(renderItem as RenderImage).exif?.model}</p>}
                       <div class="flex flex-wrap gap-x-4 gap-y-1 text-[10px] font-mono text-white/70 tracking-wider">
                          {(renderItem as RenderImage).exif?.focalLength && <span>{(renderItem as RenderImage).exif?.focalLength}mm</span>}
                          {(renderItem as RenderImage).exif?.fStop && <span>f/{(renderItem as RenderImage).exif?.fStop}</span>}
                          {(renderItem as RenderImage).exif?.shutterSpeed && <span>{(renderItem as RenderImage).exif?.shutterSpeed}</span>}
                          {(renderItem as RenderImage).exif?.iso && <span>ISO {(renderItem as RenderImage).exif?.iso}</span>}
                       </div>
                    </div>
                  )}
                </a>
              )}
            </div>
          );
        })
      }
    </section>
  </main>

  <a href="https://instagram.com/juniesdream" target="_blank" class="instagram-link" aria-label="Instagram">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
  </a>

  <!-- Album Modals -->
  {
    validItems
      .filter((item): item is RenderAlbum => item.type === 'album')
      .map((album) => (
        <AlbumModal 
          album={album} 
          isOpen={false} 
          onClose={() => {}} 
        />
      ))
  }
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui";

  // Modal management
  function openAlbumModal(albumId: string) {
    const modal = document.getElementById(`album-modal-${albumId}`);
    const zenHeader = document.querySelector('.zen-header-horizontal');
    
    if (modal) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      
      // Disable pointer events on header when modal is open
      if (zenHeader) {
        zenHeader.classList.add('modal-open');
      }
      
      // Initialize Fancybox for images in this modal
      Fancybox.bind(`[data-fancybox="album-${albumId}"]`, {
        theme: "auto",
        mainStyle: {
          "--f-button-width": "44px",
          "--f-button-height": "44px",
          "--f-button-border-radius": "50%",
          "--f-toolbar-padding": "16px",
        },
        Carousel: {
          Arrows: false,
          Toolbar: {
            display: {
              left: [],
              middle: [],
              right: ["close"],
            },
          },
          transition: "slide",
        },
      });
    }
  }

  function closeAlbumModal(albumId: string) {
    const modal = document.getElementById(`album-modal-${albumId}`);
    const zenHeader = document.querySelector('.zen-header-horizontal');
    
    if (modal) {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      
      // Re-enable pointer events on header when modal is closed
      if (zenHeader) {
        zenHeader.classList.remove('modal-open');
      }
    }
  }

  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    // Album trigger clicks
    document.querySelectorAll('.album-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const albumId = trigger.getAttribute('data-album-id');
        if (albumId) {
          openAlbumModal(albumId);
        }
      });
    });

    // Close modal events
    document.addEventListener('close-album-modal', (e: any) => {
      if (e.detail?.albumId) {
        closeAlbumModal(e.detail.albumId);
      }
    });

    // Escape key to close modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openModals = document.querySelectorAll('[id^="album-modal-"]:not(.opacity-0)');
        openModals.forEach(modal => {
          const albumId = modal.getAttribute('data-album-id');
          if (albumId) {
            closeAlbumModal(albumId);
          }
        });
      }
    });
  });

  // Initialize Fancybox for main gallery
  Fancybox.bind("[data-fancybox='gallery']", {
    theme: "auto",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        display: {
          left: [],
          middle: [],
          right: ["close"],
        },
      },
      transition: "slide",
    },
  });

  // Museum-like "Melt" Animation
  const items = document.querySelectorAll('.gallery-item-multi');
  
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: Array.from({ length: 20 }, (_, i) => i * 0.05) // Create thresholds every 5%
  };

  const updateItemStyle = (element: HTMLElement, intersectionRatio: number = 0) => {
      // Calculate how far the element is from the center of the viewport
      const rect = element.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const elementCenter = rect.top + rect.height / 2;
      const windowCenter = windowHeight / 2;
      const distanceFromCenter = Math.abs(windowCenter - elementCenter);
      const maxDistance = windowHeight / 1.5;
      
      // Normalize distance (0 = center, 1 = far)
      let progress = Math.min(distanceFromCenter / maxDistance, 1);
      
      // If majority is visible, force focus
      if (intersectionRatio > 0.6) {
        progress = 0;
      }
      
      // Invert for "focus" effect (1 = center, 0 = far)
      const focus = 1 - progress;
      
      // Apply the "melt" effect based on position
      // When centered: sharp, opaque, normal scale
      // When edges: blurred, transparent, slightly distorted
      
      // Reduced blur by 30% (from 10/8 to ~5-7)
      const blurAmount = progress * 5; 
      const opacity = 0.3 + (focus * 0.7); // Min 0.3 opacity
      const scale = 0.95 + (focus * 0.05); // Scale from 0.95 to 1.0
      const translateY = progress * 20; // Slight drift
      const skewY = (rect.top - (windowHeight/2)) * 0.005; // Liquid distortion
      
      element.style.setProperty('--blur', `${blurAmount}px`);
      element.style.setProperty('--opacity', `${opacity}`);
      element.style.setProperty('--scale', `${scale}`);
      element.style.setProperty('--translateY', `${translateY}px`);
      element.style.setProperty('--skew', `${skewY}deg`);
      
      // Add a class when it's "focused" enough to be interactive
      if (focus > 0.8 || intersectionRatio > 0.6) {
        element.classList.add('in-focus');
      } else {
        element.classList.remove('in-focus');
      }
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      updateItemStyle(entry.target as HTMLElement, entry.intersectionRatio);
    });
  }, observerOptions);

  items.forEach(item => {
    observer.observe(item);
  });

  // Also update on scroll for smoother effect, but checking visibility
  window.addEventListener('scroll', () => {
    items.forEach(item => {
      // We rely on the observer for the "lock" state (intersectionRatio)
      // but strictly speaking, we want to update the parallax/blur effect continuously
      // as the user scrolls.
      const element = item as HTMLElement;
      updateItemStyle(element, 0); 
    });
  }, { passive: true });
</script>

<style>
  :root {
    --museum-bg: #0a0a0a;
    --museum-text: #e5e5e5;
    --museum-accent: #ffffff;
  }

  body {
    background-color: var(--museum-bg);
    color: var(--museum-text);
    font-family: 'Shippori Mincho', serif;
  }

  /* Zen Header Styles - Simplified for Museum feel */
  .zen-header-multi {
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 20;
  }

  .zen-logo {
    position: relative;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hanko {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    position: relative;
    transition: all 0.5s ease;
  }

  .hanko::after {
    content: " ";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 0 20px 5px rgba(255, 255, 255, 0.2);
  }

  .zen-decoration-line {
    width: 1px;
    height: 100px;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.3), rgba(255,255,255,0));
  }

  /* Puzzle Grid Layout */
  .multi-column-container {
    max-width: 100%;
    margin: 0;
    padding: 0 0 8rem; /* Full width, no side padding for immersive feel */
  }

  .multi-column-gallery {
    display: grid;
    /* Flexible grid with min item width */
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    grid-auto-flow: dense; /* The magic "puzzle" packer */
    gap: 0; /* Flush edges */
  }

  /* Adjust grid columns based on viewport */
  @media (max-width: 768px) {
    .multi-column-gallery {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }

  .gallery-item-multi {
    position: relative;
    overflow: hidden;
    
    /* Initial Animation State */
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Visible State (toggled by observer) */
  .gallery-item-multi.in-view {
    opacity: 1;
    transform: scale(1);
  }

  /* No more blur mask, cleaner look */
  .gallery-item-multi::before {
    display: none;
  }

  /* Frame/Matte Effect */
  .gallery-item-multi img,
  .gallery-item-multi a {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Subtle zoom on hover */
    transition: transform 0.7s ease;
  }

  .gallery-item-multi:hover img {
    transform: scale(1.05);
  }

  /* Caption/Title on Hover - Museum Label Style */
  .gallery-item-multi::after {
    content: attr(data-label);
    position: absolute;
    bottom: -30px;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
    opacity: 0;
    transition: opacity 0.3s ease;
    font-family: 'Shippori Mincho', serif;
  }

  .gallery-item-multi:hover::after {
    opacity: 1;
  }

  /* Keep Instagram link but make it subtle */
  .instagram-link {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: rgba(255,255,255,0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .instagram-link:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .instagram-link svg {
    width: 20px;
    height: 20px;
  }

  .noise-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
</style>
